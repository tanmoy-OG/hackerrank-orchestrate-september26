# Supabase Project Credentials (Database & Multi-User Authentication)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# Multi-LLM Engine Configuration (Free Tier Waterfall Architecture)
# ==============================================================================
# All keys are completely optional — if left unconfigured or if rate limits occur,
# the app seamlessly uses the next provider or falls back to the native math engine.

# Tier 1 (Primary): Google Gemini 1.5 Flash (15 RPM, 1,500 RPD free)
# Free Key (No credit card needed): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Tier 2 (Secondary Fallback): Mistral AI Small / NeMo (~60 RPM free experiment plan)
# Free Key (No credit card needed): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Tier 3 (Optional Failover): Groq Cloud (30 RPM, 1,000–14,400 RPD free)
# Free Key (No credit card needed): https://console.groq.com/keys
GROQ_API_KEY=

